{
  "name": "hono-mall-api",
  "version": "1.0.0",
  "description": "E-commerce mall API built with Hono + Drizzle + PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts && drizzle-kit push --force && tsx src/db/seed.ts",
    "test:e2e": "tsx scripts/e2e-test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@node-rs/argon2": "^2.0.2",
    "@scalar/hono-api-reference": "^0.12.2",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.10",
    "hono-openapi": "^1.3.3",
    "postgres": "^3.4.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
